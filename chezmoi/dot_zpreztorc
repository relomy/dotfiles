# Prezto module selection and behavior.
zstyle ':prezto:*:*' color 'yes'
zstyle ':prezto:load' pmodule \
  'environment' \
  'terminal' \
  'editor' \
  'history' \
  'directory' \
  'spectrum' \
  'utility' \
  'git' \
  'osx' \
  'completion' \
  'syntax-highlighting' \
  'history-substring-search' \
  'autosuggestions' \
  'prompt'

# Use vi key bindings; Starship supplies the prompt.
zstyle ':prezto:module:editor' key-bindings 'vi'
zstyle ':prezto:module:prompt' theme 'off'

# Set terminal titles from the current command and directory.
zstyle ':prezto:module:terminal' auto-title 'yes'
zstyle ':prezto:module:terminal:window-title' format '%n@%m: %s'
zstyle ':prezto:module:terminal:tab-title' format '%m: %s'
zstyle ':prezto:module:terminal:multiplexer-title' format '%s'

# Keep safe file-operation prompts in human shells, disable them for automation.
if [[ ! -o interactive \
   || -n ${CLAUDECODE:-} \
   || -n ${CODEX_CI:-} \
   || ${AI_AGENT_SHELL:-} == 1 ]]; then
  zstyle ':prezto:module:utility' safe-ops 'no'
else
  zstyle ':prezto:module:utility' safe-ops 'yes'
fi
